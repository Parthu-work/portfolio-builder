# ── Supabase (free tier) ─────────────────────────────────────────────
# Leave these three empty to run in LOCAL MODE (file-backed store + dev login),
# which is what `pnpm dev` and the e2e tests use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed to open /admin.
ADMIN_EMAILS=

# Long random string. Used to derive the daily-rotating analytics salt and to hash IPs.
ANALYTICS_SALT_SECRET=

# Public URL of this builder, e.g. https://persona.example.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Public GitHub repo that contains apps/runtime, e.g. https://github.com/you/portfolio-builder
RUNTIME_REPO_URL=

# Optional ────────────────────────────────────────────────────────────
# Branch of RUNTIME_REPO_URL to deploy from (default: main).
RUNTIME_REPO_BRANCH=main
# Force local mode in a production build (used by e2e). Ignored when Supabase is configured.
LOCAL_MODE=
# Phase-2 scaffold (off): deploy through the Vercel API instead of the Deploy Button.
FEATURE_VERCEL_API_DEPLOY=
